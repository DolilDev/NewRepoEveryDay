# Environment variables template for DailyQuest.
# Copy to .env.local (locally) and set the same keys in Vercel (Production + Preview).
# NOTE: keep real values ONLY in .env.local / the Vercel panel — never in the repo.

# --- GitHub OAuth (Auth.js) ---
# From the OAuth app settings on GitHub. For production, use a separate OAuth app
# with the callback https://YOUR-DOMAIN.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth.js (NextAuth v5) ---
# Secret for signing the session JWT. Generate: openssl rand -hex 32
NEXTAUTH_SECRET=
# Locally: http://localhost:3000. On Vercel do NOT set this variable —
# the host is detected automatically (trustHost: true in auth.ts).
NEXTAUTH_URL=http://localhost:3000

# --- OpenAI (quest generation and evaluation) ---
OPENAI_API_KEY=

# --- Neon / Postgres ---
# DATABASE_URL: pooled connection (-pooler in the hostname) — used by the application.
# DIRECT_URL: direct connection (without -pooler) — used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# --- Vercel Cron (resetting streaks) ---
# Secret protecting /api/cron/reset-streaks. Vercel automatically appends the header
# Authorization: Bearer <CRON_SECRET> when this variable is set in the project.
# Generate: openssl rand -hex 32
CRON_SECRET=
