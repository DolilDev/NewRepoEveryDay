# Szablon zmiennych srodowiskowych dla DailyQuest.
# Skopiuj do .env.local (lokalnie) i ustaw te same klucze w Vercel (Production + Preview).
# UWAGA: prawdziwe wartosci trzymaj TYLKO w .env.local / panelu Vercel — nigdy w repo.

# --- GitHub OAuth (Auth.js) ---
# Z ustawien aplikacji OAuth na GitHubie. Dla produkcji uzyj osobnej aplikacji OAuth
# z callbackiem https://TWOJA-DOMENA.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Auth.js (NextAuth v5) ---
# Sekret do podpisu JWT sesji. Wygeneruj: openssl rand -hex 32
NEXTAUTH_SECRET=
# Lokalnie: http://localhost:3000. Na Vercel NIE ustawiaj tej zmiennej —
# host jest wykrywany automatycznie (trustHost: true w auth.ts).
NEXTAUTH_URL=http://localhost:3000

# --- OpenAI (generowanie i ocena questow) ---
OPENAI_API_KEY=

# --- Neon / Postgres ---
# DATABASE_URL: polaczenie pooled (-pooler w hostnamie) — uzywane przez aplikacje.
# DIRECT_URL: polaczenie bezposrednie (bez -pooler) — uzywane przez migracje Prisma.
DATABASE_URL=
DIRECT_URL=

# --- Vercel Cron (zerowanie streakow) ---
# Sekret chroniacy /api/cron/reset-streaks. Vercel sam dokleja naglowek
# Authorization: Bearer <CRON_SECRET>, gdy ta zmienna jest ustawiona w projekcie.
# Wygeneruj: openssl rand -hex 32
CRON_SECRET=
