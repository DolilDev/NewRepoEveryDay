// DailyQuest database schema (Neon / Postgres).
// Pooled connection (DATABASE_URL) for application queries, direct (DIRECT_URL) for migrations.
// Table and column names are mapped to snake_case (Postgres convention), while client fields stay camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Quest completion status.
enum QuestStatus {
  PENDING
  PASSED
  FAILED
}

// Application user (pulled from the GitHub profile). The root of all relations.
model User {
  id          String   @id @default(cuid())
  githubLogin String   @unique @map("github_login")
  githubName  String?  @map("github_name")
  avatarUrl   String?  @map("avatar_url")
  profileUrl  String?  @map("profile_url")
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at") // joined the application

  // Relations (everything tied together by user_id):
  quests       Quest[]
  completions  Completion[]
  achievements Achievement[]
  chatMessages ChatMessage[]
  stats        Stats?

  @@map("users")
}

// A single quest generated for a user on a given day.
// Repo-container model: a quest is a SUBFOLDER in a single NERD-NewEveryDayRepo repo.
// The folder* fields are the source of truth; repoName/repoUrl remain as nullable LEGACY
// (the old "separate repo per quest" model) and are no longer written.
model Quest {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  date         DateTime
  title        String
  repoName     String?     @map("repo_name") // LEGACY — old 1 repo/quest model
  folderName   String?     @map("folder_name") // subfolder in the repo-container (e.g. NERD-rust-wasm)
  why          String
  instructions String
  openPart     String      @map("open_part")
  criteria     Json // list of completion criteria (array of strings)
  status       QuestStatus @default(PENDING)
  repoUrl      String?     @map("repo_url") // LEGACY
  folderUrl    String?     @map("folder_url") // URL to the quest folder in the repo-container
  questMdUrl   String?     @map("quest_md_url") // URL to QUEST.md in the folder
  createdAt    DateTime    @default(now()) @map("created_at")
  lastEvaluatedAt DateTime? @map("last_evaluated_at") // last evaluation attempt — anti-spam cooldown

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions Completion[]

  @@index([userId])
  @@map("quests")
}

// Completion log — the source for the heatmap and the streak.
model Completion {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  questId           String   @map("quest_id")
  date              DateTime
  repoUrl           String?  @map("repo_url")
  descriptionOfWork String?  @map("description_of_work") // short description for the heatmap
  createdAt         DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@map("completions")
}

// User statistics — exactly one row per user.
model Stats {
  id            String @id @default(cuid())
  userId        String @unique @map("user_id")
  currentStreak Int    @default(0) @map("current_streak")
  longestStreak Int    @default(0) @map("longest_streak")
  totalQuests   Int    @default(0) @map("total_quests")
  points        Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stats")
}

// Unlocked achievements. The (user_id, type) pair is unique — granted once.
// IMPORTANT: rows are permanent — achievements are not revoked (no delete cascade).
model Achievement {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String // e.g. "streak_7"
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("achievements")
}

// User chat messages.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_messages")
}
